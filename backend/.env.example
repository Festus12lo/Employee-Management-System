# Django Configuration
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app,.netlify.app

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,https://your-frontend.onrender.com

# CSRF Configuration
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,https://*.netlify.app

# Server Port
PORT=8000
